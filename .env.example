# Supabase (required for live mode)
VITE_SUPABASE_URL=
# Preferred: rotatable/revocable publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (used only if the publishable key is unset)
VITE_SUPABASE_ANON_KEY=

# Public decoy site (optional overrides)
VITE_PUBLIC_SITE_NAME="International Society for Optimal Rubber Band Storage"
VITE_PUBLIC_SITE_TAGLINE="Because loose rubber bands deserve dignity."

# Disguised staff login — path must match route; label appears in landing footer
VITE_STAFF_LOGIN_PATH="/archive/member-registry"
VITE_DISGUISED_LOGIN_LABEL="Member registry"
