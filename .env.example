# Supabase (required for live mode)
VITE_SUPABASE_URL=
# Preferred: rotatable/revocable publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (used only if the publishable key is unset)
VITE_SUPABASE_ANON_KEY=

# Login metadata (optional overrides)
VITE_PUBLIC_SITE_NAME="MetalERP Security Testing"
VITE_PUBLIC_SITE_TAGLINE="Isolated ERP security testing environment."

# Login heading
VITE_DISGUISED_LOGIN_LABEL="MetalERP"
